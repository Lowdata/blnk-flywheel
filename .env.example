# ── Frontend (Vite) ─────────────────────────────────────────────
# live = real wallet + real holdings (default)
# mock = offline fixtures, used for design work
VITE_BLNK_MODE=live

# WalletConnect project id — free at https://cloud.reown.com
# Without it the wallet list is injected + Coinbase only (no mobile QR pairing).
VITE_WALLETCONNECT_PROJECT_ID=

# Optional overrides
# VITE_API_URL=/api
# VITE_RPC_URL=

# ── Server-side only. NEVER prefix these with VITE_ ─────────────
# Anything VITE_-prefixed is inlined into the browser bundle and public.

# Required for soft-staking. Use a POOLED connection string.
DATABASE_URL=

# Blockscout Pro key — lifts rate limits. Server-side only.
BLOCKSCOUT_API_KEY=

# OpenSea API key — the only working source for BLNK artwork, since ~78% of the
# collection's images are unretrievable over IPFS. Free at opensea.io/developer.
# Server-side only; resolved URLs are cached in the nft_images table.
OPENSEA_API_KEY=

# Optional
# RPC_URL=https://rpc.mainnet.chain.robinhood.com
# NFT_ADDRESS=0xa4598B513341CBeb37901e5f579cDa39E204077a
# ALLOWED_ORIGIN=https://your-domain.com
