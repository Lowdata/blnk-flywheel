{
  "name": "blnk-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "$BLNK holder hub \u2014 NFT staking + Color Machine dashboard on Robinhood Mainnet",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/",
    "db:setup": "node --env-file-if-exists=.env.local scripts/db-setup.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "grant": "node --env-file-if-exists=.env.local scripts/grant-balls.mjs"
  },
  "dependencies": {
    "@rainbow-me/rainbowkit": "^2.2.11",
    "@tanstack/react-query": "^5.62.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.23.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "viem": "^2.21.0",
    "wagmi": "^2.14.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vercel/node": "^5.10.1",
    "@vitejs/plugin-react": "^4.3.4",
    "pg-mem": "^3.0.14",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
